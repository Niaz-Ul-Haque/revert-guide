        "quran-23-109-forgiveness"
      ]
    },
    {
      "title": "先知与人生的意义",
      "time": "分几次简短地阅读",
      "body": "每次读几页优素福章。它是一个完整连贯的故事：与他反目的家人、长久的忍耐、诱惑、监狱，最后是宽恕。",
      "readings": ["优素福章，第12章"],
      "sourceIds": ["quran-yusuf-12"]
    },
    {
      "title": "礼拜与崇拜",
      "time": "15分钟",
      "body": "把你的阅读和礼拜联系起来。这些经文说明了礼拜的位置：它是记念，是祈求引导，也是你需要忍耐时可以去的地方。",
      "readings": ["开端章，第1章", "Quran 20:14", "Quran 2:153"],
      "sourceIds": [
        "quran-al-fatihah-1",
        "quran-20-14-prayer-remembrance",
        "quran-2-153-patience-prayer"
      ]
    },
    {
      "title": "品德与忍耐",
      "time": "10分钟",
      "body": "让这一次保持实际。读完之后问问自己：它会改变你今天怎样说话、有多耐心，以及怎样待人。",
      "readings": ["时光章，第103章", "Quran 2:153"],
      "sourceIds": ["quran-al-asr-103", "quran-2-153-patience-prayer"]
    }
  ],
  "weekPlan": [
    {
      "day": "第1天",
      "title": "从开端章开始",
      "body": "读开端章的含义，然后听一遍。把关于引导的那一句带在身边，度过这一天。",
      "sourceIds": ["quran-al-fatihah-1"]
    },
    {
      "day": "第2天",
      "title": "学习三个简短的求护章",
      "body": "读忠诚章、曙光章和世人章。留意它们关于安拉独一以及祈求保护的内容。今天不要试着背下来。",
      "sourceIds": [
        "quran-al-ikhlas-112",
        "quran-al-falaq-113",
        "quran-an-nas-114"
      ]
    },
    {
      "day": "第3天",
      "title": "为希望而读",
      "body": "慢慢读 Quran 39:53。然后用你自己的话写一句话，说说安拉的慈悯对你的处境意味着什么。",
      "sourceIds": ["quran-39-53-mercy"]
    },
    {
      "day": "第4天",
      "title": "做你自己的祈祷",
      "body": "读 Quran 2:186和23:109。然后用你自己的话，用中文做一段简短的祈祷。",
      "sourceIds": ["quran-2-186-dua-nearness", "quran-23-109-forgiveness"]
    },
    {
      "day": "第5天",
      "title": "把古兰经和礼拜联系起来",
      "body": "读 Quran 20:14，再听一遍开端章。礼拜首先是记念。做到完美是以后的事。",
      "sourceIds": ["quran-20-14-prayer-remembrance", "quran-al-fatihah-1"]
    },
    {
      "day": "第6天",
      "title": "练习忍耐",
      "body": "读 Quran 2:153和时光章。今天选一件小事，在这件事上保持耐心，或者在不说实话更容易的时候说实话。",
      "sourceIds": ["quran-2-153-patience-prayer", "quran-al-asr-103"]
    },
    {
      "day": "第7天",
      "title": "回顾并提一个问题",
      "body": "回到那段让你印象最深的经文。如果有什么让你困惑，写下确切的经文，带去问一位你信任的老师。",
      "sourceIds": ["quran-com", "seekersguidance"]
    }
  ],
