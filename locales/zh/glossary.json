[
  {
    "id": "adhan",
    "term": "阿丹",
    "arabicText": "أذان",
    "transliteration": "ah-THAAN",
    "definition": "每次礼拜之前都会宣布祈祷的呼唤。它提醒穆斯林祈祷时间已经到来，并邀请他们聚集在一起做礼拜。",
    "seeAlso": ["salah", "muadhin", "masjid"]
  },
  {
    "id": "akhlaq",
    "term": "阿克拉克",
    "arabicText": "أخلاق",
    "transliteration": "akh-LAAQ",
    "definition": "伊斯兰教教义塑造的良好品格、举止和道德。它体现在诚实、耐心、仁慈、谦逊以及待人接物的方式上。",
    "seeAlso": ["ihsan", "sabr", "shukr"]
  },
  {
    "id": "allah",
    "term": "真主",
    "arabicText": "الله",
    "transliteration": "Allah",
    "definition": "阿拉伯语中上帝的意思。穆斯林用这个名字来指代唯一的创造者和一切存在的维持者。阿拉伯语的基督徒和犹太人也用这个词来指代上帝。",
    "seeAlso": ["islam", "iman", "aqeedah"]
  },
  {
    "id": "amanah",
    "term": "阿玛纳",
    "arabicText": "أمانة",
    "transliteration": "ah-MAA-nah",
    "definition": "值得信赖并忠实地履行所托付给您的一切，无论是财产、秘密、职责还是责任。它还指在安拉面前的道德责任。",
    "seeAlso": ["akhlaq", "iman"]
  },
  {
    "id": "aqeedah",
    "term": "阿吉达",
    "arabicText": "عقيدة",
    "transliteration": "ah-KEE-dah",
    "definition": "伊斯兰教的核心信仰和信条，包括对独一真主、天使、天启书籍、先知、审判日和神圣法令的信仰。将其视为穆斯林信仰的基础。",
    "seeAlso": ["iman", "shahada", "allah"]
  },
  {
    "id": "asr",
    "term": "晡气",
    "arabicText": "العصر",
    "transliteration": "AHS-r",
    "definition": "下午晚些时候的祈祷，这是每日五次祈祷中的第三次。它在下午三点到日落之间进行。",
    "seeAlso": ["salah", "fajr", "dhuhr", "maghrib", "isha"]
  },
  {
    "id": "awrah",
    "term": "奥拉",
    "arabicText": "عورة",
    "transliteration": "AW-rah",
    "definition": "根据伊斯兰教谦虚准则，在他人面前应遮盖的身体部位。什么算作“awrah”因背景和法律意见而异。",
    "seeAlso": ["hijab", "taharah"]
  },
  {
    "id": "ayah",
    "term": "阿亚",
    "arabicText": "آية",
    "transliteration": "AH-yah",
    "definition": "《古兰经》的一节经文。这个词的字面意思是“标志”或“奇迹”。 《古兰经》由章节 (surah) 组成，每章包含许多经文。",
    "seeAlso": ["quran", "surah", "tafsir"]
  },
  {
    "id": "barakah",
    "term": "巴拉卡",
    "arabicText": "بركة",
    "transliteration": "ba-ra-kah",
    "definition": "来自真主的祝福或神圣的增加。这是一种感觉，时间、财富、知识或努力变得比预期更有益。",
    "seeAlso": ["allah", "shukr"]
  },
  {
    "id": "bidah",
    "term": "比德阿",
    "arabicText": "بدعة",
    "transliteration": "BID-ah",
    "definition": "在没有《古兰经》或圣训的坚实基础的情况下引入崇拜或信仰的宗教创新。穆斯林谨慎使用这个词，因为并不是所有新的世俗事物都是 bid'ah。",
    "seeAlso": ["sunnah", "hadith"]
  },
  {
    "id": "burqa-niqab",
    "term": "罩袍/面纱",
    "arabicText": "برقع / نقاب",
    "transliteration": "BUR-qah / ni-QAAB",
    "definition": "与一些穆斯林妇女相关的遮脸服装术语。面纱通常遮住脸部，同时让眼睛可见，而罩袍则是更全面的外层覆盖物。对它们的看法因文化和学术观点而异。",
    "seeAlso": ["hijab", "awrah"]
  },
  {
    "id": "dawah",
    "term": "宣教",
    "arabicText": "دعوة",
    "transliteration": "DA-wah",
    "definition": "通过清晰的解释、良好的举止和明智的行为邀请他人了解伊斯兰教。这不仅是公开的讲道，而且是公开的讲道。你的角色也可以成为宣教的一部分。",
    "seeAlso": ["islam", "akhlaq"]
  },
  {
    "id": "dajjal",
    "term": "达贾尔",
    "arabicText": "الدجال",
    "transliteration": "daj-JAAL",
    "definition": "伊斯兰教义中有关末世的教义中提到的一个主要骗子，有时被称为假弥赛亚。信徒被教导要寻求真主的保护，免受审判。",
    "seeAlso": ["qiyam", "aqeedah"]
  },
  {
    "id": "deen",
    "term": "迪恩",
    "arabicText": "دين",
    "transliteration": "DEEN",
    "definition": "宗教，生活方式，以及服从安拉的完整生活方式。穆斯林经常用它来表示伊斯兰教作为一种整体的生活方式，而不仅仅是一套仪式。",
    "seeAlso": ["islam", "iman"]
  },
  {
    "id": "dhikr",
    "term": "迪克尔",
    "arabicText": "ذكر",
    "transliteration": "THIK-r",
    "definition": "通过简短的短语、祈祷或冥想来记住和提及安拉的练习。它可以随时进行，是一整天感觉与上帝更亲近的美好方式。",
    "seeAlso": ["dua", "salah"]
  },
  {
    "id": "dhuhr",
    "term": "杜尔",
    "arabicText": "الظهر",
    "transliteration": "THUHR",
    "definition": "午祷，是每日五祷中的第二个。它是在太阳经过天空中的最高点后进行的。",
    "seeAlso": ["salah", "fajr", "asr", "maghrib", "isha"]
  },
  {
    "id": "dua",
    "term": "杜阿",
    "arabicText": "دعاء",
    "transliteration": "doo-AH",
    "definition": "个人向安拉的祈祷或恳求。与正式的每日五次祈祷不同，杜阿可以在任何时间、用任何语言、用你自己的话进行。这只是发自内心地与神交谈。",
    "seeAlso": ["dhikr", "salah"]
  },
  {
    "id": "eid",
    "term": "开斋节",
    "arabicText": "عيد",
    "transliteration": "EED",
    "definition": "庆祝活动或节日。穆斯林每年庆祝两个重要的开斋节：开斋节（标志着斋月的结束）和古尔邦节（朝觐期间）。这是祈祷、聚会和感恩的快乐时光。",
    "seeAlso": ["ramadan", "hajj", "salah"]
  },
  {
    "id": "fajr",
    "term": "晨曦",
    "arabicText": "الفجر",
    "transliteration": "FAJ-r",
    "definition": "黎明祈祷，这是每日五次祈祷中的第一个。它在黎明第一缕阳光和日出之间进行。许多穆斯林发现这种早祷是开始新一天的和平方式。",
    "seeAlso": ["salah", "dhuhr", "asr", "maghrib", "isha"]
  },
  {
    "id": "fard",
    "term": "法尔德",
    "arabicText": "فرض",
    "transliteration": "FARD",
    "definition": "伊斯兰教的义务行为。这样做会得到奖励，而无故故意放弃它则是有罪的。",
    "seeAlso": ["salah", "wajib", "islam"]
  },
  {
    "id": "fatwa",
    "term": "法特瓦",
    "arabicText": "فتوى",
    "transliteration": "FAT-wah",
    "definition": "由合格的学者针对问题给出的不具约束力的伊斯兰法律意见。追杀令解释了伊斯兰教义如何适用于特定问题。",
    "seeAlso": ["sharia", "imam", "ijma"]
  },
  {
    "id": "fitnah",
    "term": "菲特纳",
    "arabicText": "فتنة",
    "transliteration": "FIT-nah",
    "definition": "考验一个人的信心和品格的考验、诱惑或磨难。这个词也可以形容社会动荡或混乱。",
    "seeAlso": ["sabr", "iman"]
  },
  {
    "id": "fitrah",
    "term": "菲特拉",
    "arabicText": "فطرة",
    "transliteration": "FIT-rah",
    "definition": "每个人出生时的自然、纯洁的状态，具有认识上帝的与生俱来的倾向。伊斯兰教教导说，接受信仰就是回归本性，而不是外来的东西。",
    "seeAlso": ["iman", "islam", "shahada"]
  },
  {
    "id": "ghusl",
    "term": "古斯尔",
    "arabicText": "غسل",
    "transliteration": "GHOO-sl",
    "definition": "在某些情况下需要进行全身仪式清洗，例如接受伊斯兰教后、婚姻亲密后或月经后。它涉及清洗整个身体以达到净化的目的。",
    "seeAlso": ["wudu", "salah"]
  },
  {
    "id": "hadith",
    "term": "圣训",
    "arabicText": "حديث",
    "transliteration": "ha-DEETH",
    "definition": "先知穆罕默德（愿他安息）的有记录的言论、行动或认可。圣训集与《古兰经》一样是伊斯兰教指导的主要来源，帮助穆斯林了解如何在日常生活中应用《古兰经》。",
    "seeAlso": ["sunnah", "quran"]
  },
  {
    "id": "hajj",
    "term": "朝觐",
    "arabicText": "حج",
    "transliteration": "HAJJ",
    "definition": "每年一次的麦加朝圣是每个有身体和经济能力的穆斯林一生中至少应该去一次。它发生在伊斯兰历的特定时期，是伊斯兰教的五大支柱之一。",
    "seeAlso": ["umrah", "islam", "masjid"]
  },
  {
    "id": "halal",
    "term": "清真",
    "arabicText": "حلال",
    "transliteration": "ha-LAAL",
    "definition": "Anything that is permissible or lawful in Islam.它最常用于描述符合伊斯兰饮食指南的食物，但它适用于生活的各个方面。 If something is halal, you are free to enjoy it.",
    "seeAlso": ["haram"]
  },
  {
    "id": "haram",
    "term": "哈拉姆",
    "arabicText": "حرام",
    "transliteration": "ha-RAAM",
    "definition": "伊斯兰教禁止或禁止的任何事情，例如饮酒或猪肉。这些界限旨在保护您的福祉。如果您不确定某件事是否违法，询问和了解总是可以的。",
    "seeAlso": ["halal"]
  },
  {
    "id": "haya",
    "term": "哈亚",
    "arabicText": "حياء",
    "transliteration": "ha-YAA",
    "definition": "谦虚、害羞和有尊严的羞耻感可以使人远离错误。它影响着装、言语、行为和内心态度。",
    "seeAlso": ["hijab", "akhlaq"]
  },
  {
    "id": "hijab",
    "term": "盖头",
    "arabicText": "حجاب",
    "transliteration": "hih-JAAB",
    "definition": "通常指许多穆斯林妇女佩戴的头巾，以表达谦虚和信仰。更广泛地说，头巾指的是男性和女性在着装和行为上端庄的概念。",
    "seeAlso": ["islam", "iman"]
  },
  {
    "id": "hijrah",
    "term": "希吉拉",
    "arabicText": "هجرة",
    "transliteration": "HIJ-rah",
    "definition": "为了信仰而迁徙，特别是先知穆罕默德从麦加迁徙到麦地那。更广泛地说，这可能意味着抛开有害的情况来保护或加强你的内心。",
    "seeAlso": ["muhajir", "deen"]
  },
  {
    "id": "ibadah",
    "term": "伊巴达",
    "arabicText": "عبادة",
    "transliteration": "ih-BAA-dah",
    "definition": "对安拉的崇拜和奉献行为。它包括祈祷和禁食等正式仪式以及真诚的日常善行。",
    "seeAlso": ["salah", "dua", "dhikr"]
  },
  {
    "id": "iftar",
    "term": "开斋饭",
    "arabicText": "إفطار",
    "transliteration": "if-TAAR",
    "definition": "斋戒月或其他斋戒期间，斋戒者在日落时开斋的膳食。传统上，它在昏礼时间打开，通常配有枣子和水。",
    "seeAlso": ["sawm", "ramadan", "suhoor"]
  },
  {
    "id": "ihram",
    "term": "受戒",
    "arabicText": "إحرام",
    "transliteration": "ih-HRAAM",
    "definition": "朝圣者在朝觐或副朝之前进入的神圣状态，以及随之而来的特殊限制和意图。这个词也常用于指在此状态下穿着的简单服装。",
    "seeAlso": ["hajj", "umrah", "kaabah"]
  },
  {
    "id": "ihsan",
    "term": "伊赫桑",
    "arabicText": "إحسان",
    "transliteration": "ih-HSAAN",
    "definition": "精神卓越：以深深的真诚和意识崇拜真主，就好像你看到了他，并且知道他也看到了你。它还意味着在你所做的事情上追求美丽和卓越。",
    "seeAlso": ["iman", "akhlaq", "ibadah"]
  },
  {
    "id": "ijma",
    "term": "伊吉玛",
    "arabicText": "إجماع",
    "transliteration": "ij-MAA",
    "definition": "关于伊斯兰法律或信仰问题的学术共识。它是伊斯兰法律推理中使用的重要原则之一。",
    "seeAlso": ["ijtihad", "fatwa", "maqasid"]
  },
  {
    "id": "ijtihad",
    "term": "伊吉蒂哈德",
    "arabicText": "اجتهاد",
    "transliteration": "ij-ti-HAAD",
    "definition": "当问题没有明确解决时，合格的学者会使用仔细的独立推理来得出裁决。它需要对来源和法律方法有深入的了解。",
    "seeAlso": ["ijma", "fatwa", "sharia"]
  },
  {
    "id": "ilm",
    "term": "伊尔姆",
    "arabicText": "علم",
    "transliteration": "ILM",
    "definition": "知识，尤其是关于信仰和实践的有益知识。伊斯兰教高度强调寻求伊尔姆。",
    "seeAlso": ["quran", "hadith", "tafsir"]
  },
  {
    "id": "imam",
    "term": "阿訇",
    "arabicText": "إمام",
    "transliteration": "ih-MAAM",
    "definition": "在清真寺带领会众祈祷的人。许多伊玛目还担任社区领袖、教师和顾问。如果您对伊斯兰教有疑问，请随时联系当地的伊玛目。",
    "seeAlso": ["masjid", "salah", "jumuah"]
  },
  {
    "id": "iman",
    "term": "伊曼",
    "arabicText": "إيمان",
    "transliteration": "ee-MAAN",
    "definition": "信仰还是信念。在伊斯兰教中，iman 包含对安拉、他的天使、他的经典、他的使者、审判日和神圣法令的信仰。伊曼的波动是正常的，培育它是一生的旅程。",
    "seeAlso": ["islam", "aqeedah", "shahada"]
  },
  {
    "id": "isha",
    "term": "伊莎",
    "arabicText": "العشاء",
    "transliteration": "ih-SHAA",
    "definition": "夜间祈祷，这是每日第五次也是最后一次祈祷。它在黄昏消失后进行，可以祈祷到午夜或晨礼之前。",
    "seeAlso": ["salah", "fajr", "dhuhr", "asr", "maghrib"]
  },
  {
    "id": "islam",
    "term": "伊斯兰教",
    "arabicText": "إسلام",
    "transliteration": "is-LAAM",
    "definition": "服从上帝并与上帝和平相处的宗教。这个词来自阿拉伯语词根，意思是“和平”和“服从”。伊斯兰教教导说，只有一位真主，穆罕默德是他最后的使者。",
    "seeAlso": ["muslim", "allah", "iman", "shahada"]
  },
  {
    "id": "istikhara",
    "term": "伊斯蒂哈拉",
    "arabicText": "استخارة",
    "transliteration": "is-ti-KHAA-rah",
    "definition": "在做出决定时向真主寻求指导的祈祷和恳求。当在允许的选项之间进行选择并相信安拉的结果时，就完成了。",
    "seeAlso": ["dua", "niyyah"]
  },
  {
    "id": "jahannam",
    "term": "贾汉南",
    "arabicText": "جهنم",
    "transliteration": "ja-HAN-nam",
    "definition": "地狱火，是那些拒绝真理并坚持犯下严重错误的人在来世受到惩罚的地方。穆斯林提到它是为了警告和提醒责任。",
    "seeAlso": ["jannah", "iman"]
  },
  {
    "id": "janazah",
    "term": "贾纳扎",
    "arabicText": "جنازة",
    "transliteration": "ja-NAA-zah",
    "definition": "已故穆斯林的葬礼，尤其是葬礼祈祷。它还更广泛地指死者和埋葬过程。",
    "seeAlso": ["jannah", "jahannam"]
  },
  {
    "id": "jannah",
    "term": "詹纳",
    "arabicText": "جنة",
    "transliteration": "JAN-nah",
    "definition": "天堂，安拉许诺给义人的永恒奖赏。它被描述为一个和平、欢乐和亲近安拉的地方。",
    "seeAlso": ["jahannam", "iman", "qadr"]
  },
  {
    "id": "jihad",
    "term": "圣战",
    "arabicText": "جهاد",
    "transliteration": "ji-HAAD",
    "definition": "在真主的道路上努力奋斗。它可以指与罪恶和苦难的内心斗争，在某些情况下指受严格道德规则约束的武装斗争。",
    "seeAlso": ["sabr", "deen"]
  },
  {
    "id": "jinn",
    "term": "吉恩",
    "arabicText": "جن",
    "transliteration": "JINN",
    "definition": "由无烟之火创造的看不见的生物，像人类一样，有自由意志。有些人相信，有些人不相信。",
    "seeAlso": ["quran", "aqeedah"]
  },
  {
    "id": "jumuah",
    "term": "朱穆阿",
    "arabicText": "جمعة",
    "transliteration": "JOO-moo-ah",
    "definition": "周五集体祈祷取代了周五的杜尔祈祷。它包括布道 (khutbah)，是穆斯林社区每周一次的重要聚会。参加聚礼是与其他穆斯林建立联系的绝佳方式。",
    "seeAlso": ["salah", "masjid", "imam", "dhuhr"]
  },
  {
    "id": "kaabah",
    "term": "天房",
    "arabicText": "الكعبة",
    "transliteration": "KAH-bah",
    "definition": "麦加神圣的立方体结构，穆斯林在祈祷时面对它。它是伊斯兰教崇拜的精神中心，也是朝觐和副朝的焦点。",
    "seeAlso": ["qiblah", "hajj", "umrah"]
  },
  {
    "id": "kafir",
    "term": "卡菲尔",
    "arabicText": "كافر",
    "transliteration": "KAA-fir",
    "definition": "这一术语的字面意思是掩盖或拒绝真相的人。在伊斯兰教中，它可以指不信仰或不信道者，但应谨慎使用，而不是随意滥用。",
    "seeAlso": ["iman", "islam"]
  },
  {
    "id": "khalifah",
    "term": "哈利法",
    "arabicText": "خليفة",
    "transliteration": "kha-LEE-fah",
    "definition": "管家、继任者或代表。这个词可以指地球上的守护者，也可以指领导穆斯林社区的哈里发。",
    "seeAlso": ["deen", "amanah"]
  },
  {
    "id": "khushoo",
    "term": "库舒奥",
    "arabicText": "خشوع",
    "transliteration": "khu-SHOO",
    "definition": "祷告时要谦卑、专注、平静和敬畏。这是一种与真主同在的内在状态，而不是机械地祈祷。",
    "seeAlso": ["salah", "ihsan", "dhikr"]
  },
  {
    "id": "khutbah",
    "term": "库特巴",
    "arabicText": "خطبة",
    "transliteration": "KHUT-bah",
    "definition": "星期五祈祷前或开斋节祈祷期间由伊玛目发表的布道。它通常涵盖伊斯兰教教义、提醒和社区事务。鼓励在呼图白期间安静地聆听。",
    "seeAlso": ["jumuah", "imam", "masjid"]
  },
  {
    "id": "maghrib",
    "term": "昏礼",
    "arabicText": "المغرب",
    "transliteration": "MAGH-rib",
    "definition": "日落祈祷，这是每日五次祈祷中的第四次。它是在太阳落山后进行的。昏礼的时间窗口相对较短，一直持续到暮色褪去。",
    "seeAlso": ["salah", "fajr", "dhuhr", "asr", "isha"]
  },
  {
    "id": "mahr",
    "term": "马尔",
    "arabicText": "مهر",
    "transliteration": "MAHR",
    "definition": "作为婚姻契约的一部分，新郎送给新娘的彩礼。这是她的权利，只属于她一个人。",
    "seeAlso": ["nikah", "amanah"]
  },
  {
    "id": "makruh",
    "term": "马克鲁赫",
    "arabicText": "مكروه",
    "transliteration": "mak-ROOH",
    "definition": "伊斯兰教不喜欢但并未严格禁止的行为。避免它可能会得到回报，而这样做本身通常并不是有罪的。",
    "seeAlso": ["halal", "haram", "mubah"]
  },
  {
    "id": "maqasid",
    "term": "马克西德",
    "arabicText": "مقاصد",
    "transliteration": "ma-QAA-sid",
    "definition": "伊斯兰法的更高目标和智慧，例如保护信仰、生命、智力、家庭和财产。这个概念有助于学者理解裁决背后的目的。",
    "seeAlso": ["sharia", "ijtihad"]
  },
  {
    "id": "masjid",
    "term": "清真寺",
    "arabicText": "مسجد",
    "transliteration": "MAS-jid",
    "definition": "清真寺，穆斯林聚集祈祷和社区活动的地方。这个词的字面意思是“礼拜的地方”。清真寺是一个温馨的场所，我们随时欢迎您前来参观。",
    "seeAlso": ["salah", "imam", "jumuah"]
  },
  {
    "id": "miswak",
    "term": "米斯瓦克",
    "arabicText": "مسواك",
    "transliteration": "MIS-waak",
    "definition": "传统上用于口腔卫生的天然牙齿清洁棒。使用它与圣行有着广泛的联系。",
    "seeAlso": ["sunnah", "taharah"]
  },
  {
    "id": "muadhin",
    "term": "穆阿丁",
    "arabicText": "مؤذن",
    "transliteration": "mu-ADH-dhin",
    "definition": "宣拜的人。在清真寺里，穆阿丁向社区宣布祈祷时间。",
    "seeAlso": ["adhan", "masjid"]
  },
  {
    "id": "mubah",
    "term": "穆巴赫",
    "arabicText": "مباح",
    "transliteration": "moo-BAAH",
    "definition": "伊斯兰教中允许且宗教中立的东西。做或离开它本身不会带来罪恶或回报，除非意图改变行为。",
    "seeAlso": ["halal", "makruh"]
  },
  {
    "id": "muhajir",
    "term": "穆哈吉尔",
    "arabicText": "مهاجر",
    "transliteration": "mu-HAA-jir",
    "definition": "一个为了真主和信仰而迁移的人。历史上它常指离开麦加前往麦地那的早期穆斯林。",
    "seeAlso": ["hijrah", "deen"]
  },
  {
    "id": "muslim",
    "term": "穆斯林",
    "arabicText": "مسلم",
    "transliteration": "MUS-lim",
    "definition": "追随伊斯兰教并服从安拉意志的人。这个词与伊斯兰教同根，意思是通过臣服于真主而找到平安的人。欢迎加入这个大家庭！",
    "seeAlso": ["islam", "shahada", "iman"]
  },
  {
    "id": "mustahabb",
    "term": "穆斯塔哈布",
    "arabicText": "مستحب",
    "transliteration": "mus-ta-HABB",
    "definition": "伊斯兰教中推荐和喜爱的行为，但不是强制性的。做它会带来回报，而离开它不会带来罪恶。",
    "seeAlso": ["nafl", "sunnah"]
  },
  {
    "id": "nafl",
    "term": "纳夫尔",
    "arabicText": "نفل",
    "transliteration": "NAF-l",
    "definition": "超出要求的自愿崇拜行为。 Nafl祈祷、斋戒和慈善事业可以帮助一个人与真主更加亲近。",
    "seeAlso": ["sunnah", "witr", "salah"]
  },
  {
    "id": "nikah",
    "term": "尼卡",
    "arabicText": "نكاح",
    "transliteration": "ni-KAAH",
    "definition": "伊斯兰教的婚姻契约。它使婚姻合法并概述了权利和责任。",
    "seeAlso": ["mahr", "deen"]
  },
  {
    "id": "niyyah",
    "term": "尼耶",
    "arabicText": "نية",
    "transliteration": "NIY-yah",
    "definition": "意图。在伊斯兰教中，你的意图的真诚赋予了行动以精神价值。在进行祈祷或禁食等崇拜活动之前，您要将您的 Niyyah 牢记在心。它不需要大声说出来。",
    "seeAlso": ["salah", "sawm", "wudu"]
  },
  {
    "id": "qadr",
    "term": "卡德尔",
    "arabicText": "قدر",
    "transliteration": "QAD-r",
    "definition": "神圣的法令和安拉对万物的完美知识和决定。对盖德尔的信仰包括相信安拉知道过去、现在和将来是什么。",
    "seeAlso": ["iman", "aqeedah"]
  },
  {
    "id": "qiblah",
    "term": "朝拜",
    "arabicText": "قبلة",
    "transliteration": "QIB-lah",
    "definition": "穆斯林祈祷时所面对的方向，朝向麦加的天房。找到朝拜有助于确定礼拜和埋葬等礼拜活动的方向。",
    "seeAlso": ["kaabah", "salah"]
  },
  {
    "id": "qiyam",
    "term": "奇亚姆",
    "arabicText": "قيام",
    "transliteration": "qi-YAAM",
    "definition": "站立祈祷。它也可以指夜间祈祷，尤其是长时间站立的礼拜，例如 Qiyam al-Layl。",
    "seeAlso": ["salah", "witr", "ramadan"]
  },
  {
    "id": "quran",
    "term": "古兰经",
    "arabicText": "القرآن",
    "transliteration": "qur-AAN",
    "definition": "伊斯兰教的圣书，被认为是真主在 23 年来向先知穆罕默德（愿他安息）启示的字面话语。它是穆斯林的主要指导来源，传统上用阿拉伯语背诵。",
    "seeAlso": ["ayah", "surah", "tafsir", "tajweed", "hadith"]
  },
  {
    "id": "rakah",
    "term": "拉卡",
    "arabicText": "ركعة",
    "transliteration": "RAK-ah",
    "definition": "伊斯兰祈祷的一个单位或周期，由站立、鞠躬和俯伏组成。每日五次祈祷中的每一次都有一定数量的拉克。学习这些动作需要一些练习，这是完全正常的。",
    "seeAlso": ["salah", "wudu"]
  },
  {
    "id": "ramadan",
    "term": "斋月",
    "arabicText": "رمضان",
    "transliteration": "ra-ma-DAAN",
    "definition": "伊斯兰历第九个月，穆斯林从黎明至日落期间禁食。这是一个深刻的反思、祈祷、社区和感恩的精神时刻。您的第一个斋月是一次特殊的经历，您可以按照自己的节奏度过。",
    "seeAlso": ["sawm", "eid", "salah"]
  },
  {
    "id": "riba",
    "term": "里巴",
    "arabicText": "ربا",
    "transliteration": "ri-BAA",
    "definition": "伊斯兰法在某些金融交易中禁止高利贷或基于利息的收益。穆斯林通常使用该术语来表示违反伊斯兰教道德的剥削性或生息交易。",
    "seeAlso": ["halal", "haram", "zakat"]
  },
  {
    "id": "ruku",
    "term": "鲁库'",
    "arabicText": "ركوع",
    "transliteration": "roo-KOO",
    "definition": "礼拜时的鞠躬姿势，即礼拜者弯腰，双手放在膝盖上。它是每个 rak'ah 的主要物理支柱之一。",
    "seeAlso": ["salah", "rakah", "sajdah"]
  },
  {
    "id": "sabr",
    "term": "萨布尔",
    "arabicText": "صبر",
    "transliteration": "SAB-r",
    "definition": "为了真主的缘故，要有耐心、毅力和稳定的自制力。它包括坚定的敬拜、避免犯罪以及很好地忍受苦难。",
    "seeAlso": ["shukr", "iman", "akhlaq"]
  },
  {
    "id": "sadaqah",
    "term": "萨达卡",
    "arabicText": "صدقة",
    "transliteration": "SA-da-qah",
    "definition": "自愿慈善或出于仁慈和同情心所做的善行。与天课不同，萨达卡不是强制性的，可以像微笑、帮助邻居或分享食物一样简单。每一个善行都很重要。",
    "seeAlso": ["zakat"]
  },
  {
    "id": "sajdah",
    "term": "萨吉达",
    "arabicText": "سجدة",
    "transliteration": "SAJ-dah",
    "definition": "跪拜祈祷时，额头、鼻子、手、膝盖和脚趾接触地面。这是仆人最接近安拉的时刻之一。",
    "seeAlso": ["salah", "rakah", "ruku"]
  },
  {
    "id": "salaf",
    "term": "萨拉夫",
    "arabicText": "سلف",
    "transliteration": "SA-laf",
    "definition": "早期正义的穆斯林世代，特别是先知的同伴、他们的学生以及他们的后代。它们通常被视为理解和实践的重要例子。",
    "seeAlso": ["sunnah", "hadith"]
  },
  {
    "id": "salah",
    "term": "萨拉赫",
    "arabicText": "صلاة",
    "transliteration": "sa-LAAH",
    "definition": "正式的伊斯兰祈祷每天进行五次。它是伊斯兰教的五大支柱之一，也是您与真主之间的直接联系。学习礼拜需要时间，慢慢开始并逐渐积累是可以的。",
    "seeAlso": ["wudu", "fajr", "dhuhr", "asr", "maghrib", "isha", "rakah"]
  },
  {
    "id": "salam",
    "term": "萨拉姆",
    "arabicText": "سلام",
    "transliteration": "sa-LAAM",
    "definition": "和平。问候语“As-salamu alaykum”的意思是“愿你平安”，是穆斯林彼此问候的标准方式。回应是“Wa alaykum as-salam”（“愿你平安”）。这是一个热情好客的传统。",
    "seeAlso": ["islam", "muslim"]
  },
  {
    "id": "sawm",
    "term": "锯木",
    "arabicText": "صوم",
    "transliteration": "SOWM",
    "definition": "禁食，尤其是在斋月期间。穆斯林从黎明到日落都禁止食物、饮料和其他身体需求。斋戒是伊斯兰教的五大支柱之一，也是精神成长和自律的时期。",
    "seeAlso": ["ramadan", "niyyah"]
  },
  {
    "id": "shahada",
    "term": "清真言",
    "arabicText": "شهادة",
    "transliteration": "sha-HAA-dah",
    "definition": "信仰宣言和伊斯兰教的第一支柱：“我作证，除真主外，绝无应有的神，穆罕默德是他的使者。”真诚地说清真言是一个人进入伊斯兰教的方式。这是您旅程中最重要的一步。",
    "seeAlso": ["islam", "muslim", "iman", "allah"]
  },
  {
    "id": "sharia",
    "term": "伊斯兰教法",
    "arabicText": "شريعة",
    "transliteration": "sha-REE-ah",
    "definition": "伊斯兰教的神圣道德和法律指导源自《古兰经》和《圣训》。它涵盖敬拜、道德、家庭生活、财务、正义等等。",
    "seeAlso": ["maqasid", "fatwa", "halal"]
  },
  {
    "id": "shirk",
    "term": "推脱",
    "arabicText": "شرك",
    "transliteration": "SHIRK",
    "definition": "在崇拜、主权或他独特的属性中与安拉结为伙伴。如果一个人死后没有悔改，这被认为是最严重的罪过。",
    "seeAlso": ["tawhid", "aqeedah", "allah"]
  },
  {
    "id": "shukr",
    "term": "舒克尔",
    "arabicText": "شكر",
    "transliteration": "SHOOK-r",
    "definition": "感谢并感谢真主的祝福。真正的shukr包括内心感恩、表达感恩、善用祝福。",
    "seeAlso": ["sabr", "barakah", "allah"]
  },
  {
    "id": "sirah",
    "term": "西拉",
    "arabicText": "سيرة",
    "transliteration": "SEE-rah",
    "definition": "先知穆罕默德的传记和生平故事。研究西拉有助于穆斯林了解《古兰经》和先知的品格。",
    "seeAlso": ["hadith", "sunnah", "quran"]
  },
  {
    "id": "suhoor",
    "term": "封斋节",
    "arabicText": "سحور",
    "transliteration": "su-HOOR",
    "definition": "禁食开始前黎明前吃的一餐。建议这样做，并有助于为禁食日提供体力。",
    "seeAlso": ["sawm", "ramadan", "iftar"]
  },
  {
    "id": "sunnah",
    "term": "圣行",
    "arabicText": "سنة",
    "transliteration": "SOON-nah",
    "definition": "先知穆罕默德（愿他安息）的教义、实践和生活方式。遵循圣行有助于穆斯林了解如何在日常生活中应用《古兰经》。它涵盖了从祈祷到仁慈再到日常习惯的一切。",
    "seeAlso": ["hadith", "quran"]
  },
  {
    "id": "surah",
    "term": "古兰经",
    "arabicText": "سورة",
    "transliteration": "SOO-rah",
    "definition": "《古兰经》的一章。共有 114 章古兰经，长度从几节到几页不等。许多新穆斯林从《古兰经》末尾学习较短的古兰经开始，以便在日常祈祷中使用。",
    "seeAlso": ["quran", "ayah", "tafsir"]
  },
  {
    "id": "tafsir",
    "term": "塔夫西尔",
    "arabicText": "تفسير",
    "transliteration": "taf-SEER",
    "definition": "对古兰经的学术解释和解释。 Tafsir 帮助您理解每节经文背后的背景、含义和教训。与《古兰经》一起阅读值得信赖的塔夫西尔可以使您的学习更加丰富。",
    "seeAlso": ["quran", "ayah", "surah"]
  },
  {
    "id": "taharah",
    "term": "塔哈拉",
    "arabicText": "طهارة",
    "transliteration": "ta-HAA-rah",
    "definition": "崇拜需要或鼓励仪式的纯洁和清洁。它包括通过小净、大净进行净化，并保持身体、衣服和场所清洁。",
    "seeAlso": ["wudu", "ghusl", "salah"]
  },
  {
    "id": "tajweed",
    "term": "泰吉威德",
    "arabicText": "تجويد",
    "transliteration": "taj-WEED",
    "definition": "在背诵过程中正确发音《古兰经》字母和单词的一套规则。学习泰吉威德是一个渐进的过程，许多穆斯林随着时间的推移学习它。一开始就不要担心完美。",
    "seeAlso": ["quran", "surah"]
  },
  {
    "id": "takbir",
    "term": "塔克比尔",
    "arabicText": "تكبير",
    "transliteration": "tak-BEER",
    "definition": "说“Allahu Akbar”（“安拉是最伟大的”）。它出现在祈祷和许多其他敬拜活动中。",
    "seeAlso": ["salah", "eid"]
  },
  {
    "id": "taqwa",
    "term": "塔克瓦",
    "arabicText": "تقوى",
    "transliteration": "taq-WAA",
    "definition": "上帝意识、对真主的正念以及引导人服从他并避免犯罪的保护意识。它是伊斯兰精神生活的中心目标之一。",
    "seeAlso": ["iman", "sawm", "ihsan"]
  },
  {
    "id": "tashahhud",
    "term": "塔沙胡德",
    "arabicText": "تشهد",
    "transliteration": "ta-shah-HUD",
    "definition": "礼拜期间背诵的坐证。它包括问候语、信仰见证和对先知的祈祷。",
    "seeAlso": ["salah", "rakah"]
  },
  {
    "id": "tawbah",
    "term": "托巴",
    "arabicText": "توبة",
    "transliteration": "TAW-bah",
    "definition": "悔改，或者在犯了错误后真诚地转向真主。伊斯兰教教导说，真主随时准备宽恕。犯tawbah仅仅意味着承认错误，感到真正的遗憾，并打算不再重蹈覆辙。",
    "seeAlso": ["dua", "allah", "iman"]
  },
  {
    "id": "tawhid",
    "term": "塔维德",
    "arabicText": "توحيد",
    "transliteration": "taw-HEED",
    "definition": "安拉的绝对独一性和单独崇拜他。它是伊斯兰教信仰的基础。",
    "seeAlso": ["allah", "aqeedah", "shirk"]
  },
  {
    "id": "ummah",
    "term": "乌玛",
    "arabicText": "أمة",
    "transliteration": "UM-mah",
    "definition": "全世界穆斯林社区因信仰团结在一起。这个词强调共同的责任、归属感以及兄弟姐妹情谊。",
    "seeAlso": ["muslim", "masjid", "jumuah"]
  },
  {
    "id": "umrah",
    "term": "副朝",
    "arabicText": "عمرة",
    "transliteration": "UM-rah",
    "definition": "与有固定日期的朝觐不同，可以在一年中的任何时间进行自愿前往麦加的朝圣。这是一次较短且不那么复杂的朝圣之旅，但却是一次深刻的精神体验。",
    "seeAlso": ["hajj", "masjid"]
  },
  {
    "id": "wajib",
    "term": "瓦吉布",
    "arabicText": "واجب",
    "transliteration": "WAA-jib",
    "definition": "这是必需的行为，尤其是在哈乃斐术语中。它类似于义务，尽管一些学者将其与证据强度区别开来。",
    "seeAlso": ["fard", "salah"]
  },
  {
    "id": "witr",
    "term": "维特尔",
    "arabicText": "وتر",
    "transliteration": "WIT-r",
    "definition": "在伊莎之后进行的奇数祈祷，通常作为当晚的结束祈祷。它在伊斯兰实践中受到特别强调和喜爱。",
    "seeAlso": ["salah", "isha", "nafl"]
  },
  {
    "id": "wudu",
    "term": "武都",
    "arabicText": "وضوء",
    "transliteration": "woo-DOO",
